# Copy to .env (git-ignored) and fill in. Never commit real values.

# Supabase Management API (supabase.com → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Netlify API (User settings → Applications → Personal access tokens)
NETLIFY_AUTH_TOKEN=

# Email sender for Supabase Auth (see supabase/auth-config.json)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: throwaway test couple (mail.tm inboxes)
TEST_A_EMAIL=
TEST_A_MAILTM_PASSWORD=
TEST_A_APP_PASSWORD=
TEST_B_EMAIL=
TEST_B_MAILTM_PASSWORD=
TEST_B_APP_PASSWORD=
